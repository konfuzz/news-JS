{
  "name": "news",
  "version": "1.0.0",
  "description": "News API",
  "main": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsx node_modules/webpack/bin/webpack --mode=production",
    "build:dev": "tsx node_modules/webpack/bin/webpack --mode=development",
    "build:prod": "tsx node_modules/webpack/bin/webpack --mode=production",
    "deploy": "npm run build && npx gh-pages -d dist",
    "format": "prettier --write .",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "typecheck": "tsc",
    "watch": "tsx node_modules/webpack/bin/webpack --mode=development --watch",
    "start": "tsx node_modules/webpack/bin/webpack serve --mode=development"
  },
  "keywords": [],
  "author": "Aleh Serhiyenia",
  "contributors": [
    "Sergey Koksharov <gentoosiastic@gmail.com>"
  ],
  "license": "ISC",
  "devDependencies": {
    "@types/dotenv-webpack": "^7.0.8",
    "@types/node": "^26.6.6",
    "css-loader": "^7.1.5",
    "dotenv-webpack": "^9.0.0",
    "esbuild-loader": "^4.5.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-webpack-plugin": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.10",
    "style-loader": "^4.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  }
}
